# ── Copy this file to .env and fill in your values ────────────────────────────
#
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# The app reads .env automatically — no need to export variables in your shell.

# ── Detector mode ─────────────────────────────────────────────────────────────
FIRST_AID_MODEL_MODE=workflow

# ── Roboflow API key (required for workflow mode) ─────────────────────────────
# Get yours at: app.roboflow.com → Settings → API Keys
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# ── Thresholds ────────────────────────────────────────────────────────────────
# Keep both at 0.40 — the YOLO26m workflow returns confs in the 0.40–0.85 range.
# Setting these higher than 0.50 will cause reliable detections to be ABSTAINED.
FIRST_AID_CONFIDENCE_THRESHOLD=0.40
FIRST_AID_OOD_THRESHOLD=0.60

# ── Debug (optional) — set to 1 to log raw workflow responses ─────────────────
# ROBOFLOW_WORKFLOW_DEBUG=1

# ── Storage ───────────────────────────────────────────────────────────────────
FIRST_AID_DATA_DIR=data
FIRST_AID_MAX_UPLOAD_MB=100
FIRST_AID_RETENTION_HOURS=24
